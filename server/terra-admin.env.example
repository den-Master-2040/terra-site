# Скопировать в /etc/terra-admin.env (sudo chmod 600), заполнить.
# Хеш пароля: python3 server/admin/terra_admin.py hash-password
ADMIN_PASSWORD_HASH=
# Любая длинная случайная строка: python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=
# GitHub → Settings → Developer settings → Fine-grained tokens: только репозиторий terra-site, Contents: Read and write
GITHUB_TOKEN=
GITHUB_REPO=den-Master-2040/terra-site
GITHUB_BRANCH=main
LISTEN=127.0.0.1:12081
